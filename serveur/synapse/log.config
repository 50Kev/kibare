# seuls les avertissements et erreurs sont gardes : pas de journal des requetes ni des adresses IP
version: 1
formatters:
  simple:
    format: "%(asctime)s %(levelname)s %(name)s %(message)s"
handlers:
  console:
    class: logging.StreamHandler
    formatter: simple
loggers:
  synapse.access:
    level: ERROR
  synapse.storage.SQL:
    level: ERROR
root:
  level: WARNING
  handlers: [console]
disable_existing_loggers: false
